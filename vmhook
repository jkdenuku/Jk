    VMHOOK_META = VMHOOK_META,
    VMHOOK_STRING_POOL = VMHOOK_STRING_POOL,
    VMHOOK_EVENTS = VMHOOK_EVENTS,
    VMHOOK_REPLAY = VMHOOK_REPLAY,
}

