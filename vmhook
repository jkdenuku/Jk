local function __vmhook_resolve(idx)
    if idx == nil then return nil end
    return VMHOOK_STRING_POOL[idx]
end

local VMHOOK_REPLAY = {}
function VMHOOK_REPLAY.run(env)
    local out = {}
    for i = 1, #VMHOOK_EVENTS do
        local ev = VMHOOK_EVENTS[i]
        local row = {
            seq = ev.seq,
            leaf_id = ev.leaf_id,
            pos = ev.pos,
            ts = ev.ts,
            blocked = ev.blocked and true or false,
            scenario_id = ev.scenario_id,
            source = __vmhook_resolve(ev.source_i),
            kind = __vmhook_resolve(ev.kind_i),
            name = __vmhook_resolve(ev.name_i),
            mode = __vmhook_resolve(ev.mode_i),
            session_id = __vmhook_resolve(ev.session_id_i),
            error = __vmhook_resolve(ev.error_i),
            args = {},
            results = {},
        }
        for j = 1, #(ev.args_i or {}) do
            row.args[j] = __vmhook_resolve(ev.args_i[j])
        end
        for j = 1, #(ev.results_i or {}) do
            row.results[j] = __vmhook_resolve(ev.results_i[j])
        end
        out[#out + 1] = row
        if env and type(env.on_event) == "function" then
            pcall(env.on_event, row, ev)
        end
    end
    return out
end

